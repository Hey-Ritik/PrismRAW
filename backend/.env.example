# Documentation only: the app reads process environment, not this file automatically.
# Render Blueprint sets its hosted values; local defaults remain 512px / 2 threads.
PORT=7860
PRISMRAW_HOSTED=1
PRISMRAW_MAX_CROP=256
PRISMRAW_TORCH_THREADS=1
# Split deployment: Render-only settings (local runs can leave these unset).
PRISMRAW_API_ONLY=1
# Replace with your actual Vercel production origin before using cross-origin access.
PRISMRAW_FRONTEND_ORIGINS=https://your-project.vercel.app
